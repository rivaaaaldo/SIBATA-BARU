# =====================================================================
# .env.example — SALIN menjadi file privat bernama ".env" di LUAR document root.
# JANGAN commit file .env asli ke repository. Isi placeholder di bawah.
#
# Aturan penulisan:
#  - satu baris KUNCI=nilai, tanpa spasi di sekitar "="
#  - nilai yang mengandung simbol ($ # spasi) diapit tanda kutip tunggal '...'
# =====================================================================

# local  = XAMPP/pengembangan (boleh DB_PASS kosong, error tampil)
# production = hosting (DEFAULT bila tidak diisi; error disembunyikan; DB_PASS wajib terisi)
APP_ENV=production

# ---- Database ----
DB_HOST=localhost
DB_NAME=peminjaman_lab
DB_USER=ganti_user_database
DB_PASS='ganti_password_database'

# ---- WhatsApp Asisten Lab (format internasional, tanpa "+" dan tanpa "0" di depan) ----
WA_ASLAB=62xxxxxxxxxxx

# ---- Gemini (baca KTM). Kosongkan hanya jika fitur baca KTM tidak dipakai. ----
GEMINI_API_KEY='ganti_dengan_api_key_gemini'
GEMINI_MODEL=gemini-3.6-flash
# Verifikasi sertifikat SSL ke Google (DEFAULT 1 = aktif). Isi 0 HANYA di XAMPP bila cURL
# gagal "SSL certificate problem" dan Anda belum memasang cacert.pem (lihat README).
GEMINI_SSL_VERIFY=1

# ---- Login admin tunggal (hash, BUKAN password) ----
# Buat:  php -r "echo password_hash('PasswordAnda', PASSWORD_DEFAULT);"
# Wajib diapit tanda kutip tunggal. Tidak dipakai lagi setelah mode multi-admin aktif.
ADMIN_PASSWORD_HASH='$2y$10$ganti.dengan.hasil.password_hash'
